import tkinter as tk
root = tk.Tk()
root.title("rekenmachine")
root.geometry("250x350")
root.configure(bg="lightblue")

nieuw_getal = False
#functie toevoegen om op knop te drukken
def klik(waarde):
    global nieuw_getal

    if nieuw_getal:
        resultaat.delete(0, tk.END)
        nieuw_getal = False

    resultaat.insert(tk.END, waarde)
#andere functies
def clear():
    resultaat.delete(0, tk.END)
def bereken():
    global nieuw_getal

    try:
        som = resultaat.get()
        antwoord = eval(som)

        resultaat.delete(0, tk.END)
        resultaat.insert(0, antwoord)

        nieuw_getal = True

    except:
        resultaat.delete(0, tk.END)
        resultaat.insert(0, "Error")


resultaat=tk.Entry(root,)
resultaat.grid(row=0, column=1,ipadx=30, ipady=10, padx=5, pady=10, columnspan=4)

button0 = tk.Button(root, text="0",command=lambda: klik("0"),bg="lightblue")
