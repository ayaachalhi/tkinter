from tkinter import *

root = Tk()
root.title("rekenmachine")
root.geometry("500x500")
# Label bovenaan met pack()
titel = Label(root, text="rekenmachine", font=("Arial", 14))
titel.pack(pady=10)

# Frame voor de overige widgets
frame = Frame(root)
frame.pack(padx=15, pady=15)

# Labels en Entry-velden met grid()
Label(frame, text="getal 1:").grid(row=0, column=0, padx=5, pady=5, sticky="e")
entry_getal1 = Entry(frame)
entry_getal1.grid(row=0, column=1, padx=5, pady=5)

Label(frame, text="getal 2").grid(row=1, column=0, padx=5, pady=5, sticky="e")
entry_getal2 = Entry(frame)
entry_getal2.grid(row=1, column=1, padx=5, pady=5)

#knop
Button(frame, text="+", command=print).grid(row=2, column=0, padx=5, pady=5)
Button(frame, text="-", command=print).grid(row=2, column=1, padx=5, pady=5)
Button(frame, text="*", command=print).grid(row=2, column=2, padx=5, pady=5)
Button(frame, text=":", command=print).grid(row=2, column=3, padx=5, pady=5)

# Knop onderaan
Label(frame, text="resultaat").grid(row=3, column=0, padx=5, pady=5, sticky="e")
entry_resultaat = Entry(frame)
entry_resultaat.grid(row=3, column=1, padx=5, pady=5)

root.mainloop()
